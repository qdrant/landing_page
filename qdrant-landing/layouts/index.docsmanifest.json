{{- /*
  Machine-readable index of every published page that has a Markdown version
  at `<page>/index.md`, served at /docs-manifest.json. Two readers in
  qdrant/page-search depend on it, so treat the field names as a public
  contract: add fields freely, but do not rename or remove them without
  updating both.
  - The docs MCP server at search.qdrant.tech/mcp (rust_search/src/docs_mcp/)
    lists pages and resolves aliases with it. It keeps only the
    documentation, articles, blog, and course.
  - `index_pages` (rust_search/src/index_pages.rs) builds the `pages`
    collection from it, which suggests existing pages in place of missing
    ones, so it lists every such page, not only the documentation.

  Sections with `build: render: never` group pages in the sidebar without a
  page of their own. They are listed with "rendered": false and no URLs.
  Pages without a Markdown version, such as the home page, are left out.
*/ -}}
{{- $pages := slice -}}
{{- range site.Pages.ByWeight -}}
  {{- if not (in (slice "page" "section") .Kind) -}}{{- continue -}}{{- end -}}
  {{- $rendered := true -}}
  {{- with .Params.build -}}
    {{- $render := .render | default "always" -}}
    {{- if eq $render "link" -}}{{- continue -}}{{- end -}}
    {{- if eq $render "never" -}}{{- $rendered = false -}}{{- end -}}
  {{- end -}}
  {{- /* An unrendered page has no permalink, so its path comes from the content tree. */ -}}
  {{- $path := .RelPermalink -}}
  {{- if not $rendered -}}
    {{- if ne .Kind "section" -}}{{- continue -}}{{- end -}}
    {{- $path = printf "%s/" .Path -}}
  {{- end -}}
  {{- if eq .Params.sitemapExclude true -}}{{- continue -}}{{- end -}}
  {{- if .Sitemap.Disable -}}{{- continue -}}{{- end -}}
  {{- if eq .Title "" -}}{{- continue -}}{{- end -}}
  {{- $markdown := .OutputFormats.Get "markdown" -}}
  {{- if and $rendered (not $markdown) -}}{{- continue -}}{{- end -}}
  {{- $description := "" -}}
  {{- with .Description -}}
    {{- $description = . | plainify | replaceRE `\s+` " " | strings.TrimSpace -}}
  {{- else -}}
    {{- $description = .Summary | plainify | replaceRE `\s+` " " | strings.TrimSpace | truncate 200 "" -}}
  {{- end -}}
  {{- $aliases := slice -}}
  {{- range .Aliases -}}{{- $aliases = $aliases | append . -}}{{- end -}}
  {{- $entry := dict
    "path" $path
    "title" .Title
    "description" $description
    "kind" .Kind
    "partition" (partial "common/get-partition.html" (dict "page" .) | default "")
    "weight" .Weight
    "aliases" $aliases
  -}}
  {{- if $rendered -}}
    {{- $entry = merge $entry (dict "url" .Permalink "markdown_url" $markdown.Permalink) -}}
  {{- else -}}
    {{- $entry = merge $entry (dict "rendered" false) -}}
  {{- end -}}
  {{- with .Params.external_url -}}{{- $entry = merge $entry (dict "external_url" .) -}}{{- end -}}
  {{- if not .Date.IsZero -}}{{- $entry = merge $entry (dict "date" (.Date.Format "2006-01-02")) -}}{{- end -}}
  {{- if not .Lastmod.IsZero -}}{{- $entry = merge $entry (dict "lastmod" (.Lastmod.Format "2006-01-02")) -}}{{- end -}}
  {{- $pages = $pages | append $entry -}}
{{- end -}}
{{- dict "version" 1 "base_url" site.BaseURL "pages" $pages | jsonify (dict "indent" "  ") -}}
