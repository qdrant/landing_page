      {
        "id": "a01",
        "start_sec": 0.0,
        "end_sec": 2.34,
        "text": "Now, as the footer the ladder,",
        "word_count": 6
      },
      {
        "id": "a02",
        "start_sec": 3.18,
        "end_sec": 4.7,
        "text": "the lamp footbeds are only",
        "word_count": 5
      },
      {
        "id": "a03",
        "start_sec": 7.26,
        "end_sec": 11.4,
        "text": "depressed in the surface about one or two inches.",
        "word_count": 9
      },
      {
        "id": "a04",
        "start_sec": 12.3,
        "end_sec": 21.16,
        "text": "Although the surface appears to be very fine green, did you get close to it, it's almost like a powder.",
        "word_count": 20
      },
      {
        "id": "a05",
        "start_sec": 22.68,
        "end_sec": 24.46,
        "text": "Ground mass is very fine.",
        "word_count": 5
      },
      {
        "id": "a06",
        "start_sec": 36.34,
        "end_sec": 38.14,
        "text": "Now I'm going to step on to land now.",
        "word_count": 9
      },
      {
        "id": "a07",
        "start_sec": 47.6,
        "end_sec": 49.92,
        "text": "That's one small step for man.",
        "word_count": 6
      },
      {
        "id": "a08",
        "start_sec": 53.06,
        "end_sec": 55.16,
        "text": "One giant leap for mankind.",
        "word_count": 5
      }
    ],
