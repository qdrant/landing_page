    "names": ["qdrant", "blue", "teal", "violet", "amber"],
    "muted": "#b4bacc"
  },
  "surface": {
    "ink": "#161e33",
    "inkMuted": "#576280",
    "page": "#ffffff",
    "panel": "#f0f3fa",
    "grid": "#d4d9e6",
    "axis": "#8f98b2"
  },
  "tone": {
